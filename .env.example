# Google APIs — configure these as environment variables in Hetzner's Node.js configuration
GOOGLE_SERVICE_ACCOUNT_KEY=your-google-service-account-json
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Optional: secret for signing image/gallery URLs and contact-form tokens.
# Defaults to a value derived from GOOGLE_SERVICE_ACCOUNT_KEY.
URL_SIGNING_SECRET=

# Contact form — mailbox created in konsoleH, sent via Hetzner SMTP (STARTTLS on port 587)
SMTP_HOST=mail.your-server.de
SMTP_PORT=587
SMTP_USER=website@lootuskollektiv.de
SMTP_PASSWORD=your-mailbox-password
CONTACT_FROM=website@lootuskollektiv.de
CONTACT_TO=felix@ettl-info.de

# Hetzner Webhosting L SFTP deployment credentials
# Keep real local values in `.env` and add these five names as GitHub Actions secrets.
HETZNER_SFTP_HOST=your-hetzner-server
HETZNER_SFTP_PORT=22
HETZNER_SFTP_USERNAME=your-hetzner-login
HETZNER_SFTP_PASSWORD=your-hetzner-password
HETZNER_DEPLOY_PATH=/public_html
