# Google Calendar API — needed for event data at build time
GOOGLE_API_KEY=your-google-api-key
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Vercel Blob store token — persists Drive images/gallery lists so they survive cold starts
# and sporadic low-traffic gaps. Auto-injected by Vercel when a Blob store is connected to
# the project; only needed locally for `astro dev`.
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token
