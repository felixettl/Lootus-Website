---
import Photo from './Photo.astro'
import { media } from '../data/media.js'
---

<section class="band" aria-label="Am Floor">
  <Photo
    src={media.crowdRed}
    alt="Roter Floor, tief in der Nacht"
    class="bandPhoto"
    position="50% 45%"
    shade="left"
    seed={14}
  />
  <div class="bandInner">
    <div data-animate="rise" data-scroll style="--y:16px" class="bandKicker">
      Zwischen Kreuzlingen und Friedrichshafen
    </div>
    <h2 class="bandLine" data-animate="lines" data-scroll>
      <span class="lineMask"><span>Wenn das Ufer</span></span>
      <span class="lineMask"><span style="--delay:0.08s"><em class="em">verschwindet.</em></span></span>
    </h2>
  </div>
</section>
