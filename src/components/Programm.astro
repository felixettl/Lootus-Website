---
import Photo from './Photo.astro'
import type { CalendarEvent } from '../data/calendar'
import { imageUrl } from '../lib/sanity'

interface Props {
  events: CalendarEvent[]
}
const { events } = Astro.props
---

<section class="programm" id="programm" aria-label="Programm">
  <div class="sectionHead">
    <h2 data-animate="rise" data-scroll class="sectionKicker">Programm</h2>
  </div>

  {events.length === 0 && (
    <div data-animate="rise" data-scroll style="--delay:0.12s" class="sectionNote">
      Aktuell sind keine Events geplant. Schau bald wieder vorbei.
    </div>
  )}

  <ol class="index">
    {events.map((ev, i) => (
      <li>
        <div data-animate="rise" data-scroll style={`--delay:${i * 0.04}s;--y:30px`} class="rowWrap">
          <div class="row" id={ev.id} data-status={ev.status}>
            <span class="rowNo">{String(i + 1).padStart(2, '0')}</span>

            {ev.image && (
              <span class="rowThumb" data-full={imageUrl(ev.image, 1600)} data-alt={ev.title}>
                <Photo
                  src={imageUrl(ev.image, 800)}
                  alt={[ev.title, ev.place].filter(Boolean).join(', ')}
                  class="rowThumbImg"
                  position="center"
                  shade="bottom"
                  grain={false}
                  seed={20 + i}
                />
              </span>
            )}

            <span class="rowMain">
              <span class="rowTitle">
                {ev.title}
                <span class="rowUnderline" aria-hidden="true"></span>
              </span>
              <span class="rowDetails">
                <span class="rowDetailsInner">
                  <span class="rowMeta">
                    {[ev.venue, ev.place, ev.genre].filter(Boolean).join(' · ')}
                  </span>
                  {ev.text && <span class="rowText">{ev.text}</span>}
                  {ev.tickets && (
                    <a class="rowTickets" href={ev.tickets} target="_blank" rel="noopener noreferrer">
                      Tickets →
                    </a>
                  )}
                </span>
              </span>
            </span>

            <span class="rowDate">
              <span class="rowDateNum">{ev.dateLabel}</span>
              <span class="rowStatus">
                {ev.status === 'upcoming' ? 'kommend' : 'gewesen'}
              </span>
            </span>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <dialog class="posterDialog" aria-label="Poster">
    <img class="posterDialogImg" alt="" />
  </dialog>
</section>

<script>
  // Touch devices have no hover: tapping a row opens it (larger poster + details).
  if (window.matchMedia('(hover: none)').matches) {
    const rows = document.querySelectorAll<HTMLElement>('.programm .row')
    const dialog = document.querySelector<HTMLDialogElement>('.posterDialog')!
    const dialogImg = dialog.querySelector('img')!
    const mobile = window.matchMedia('(max-width: 680px)')
    dialog.addEventListener('click', () => dialog.close())
    rows.forEach((row) => {
      row.addEventListener('click', (e) => {
        const target = e.target as HTMLElement
        if (target.closest('a')) return
        const thumb = target.closest<HTMLElement>('.rowThumb')
        if (thumb && mobile.matches && row.classList.contains('isOpen')) {
          dialogImg.src = thumb.dataset.full ?? ''
          dialogImg.alt = thumb.dataset.alt ?? ''
          dialog.showModal()
          return
        }
        const open = !row.classList.contains('isOpen')
        rows.forEach((r) => r.classList.remove('isOpen'))
        row.classList.toggle('isOpen', open)
      })
    })
  }
</script>
