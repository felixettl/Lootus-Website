---
import Photo from './Photo.astro'
import type { CalendarEvent } from '../data/calendar'

interface Props {
  events: CalendarEvent[]
}
const { events } = Astro.props
---

<section class="programm" id="programm" aria-label="Programm">
  <div class="sectionHead">
    <div data-animate="rise" data-scroll class="sectionKicker">Programm</div>
  </div>

  {events.length === 0 && (
    <div data-animate="rise" data-scroll style="--delay:0.12s" class="sectionNote">
      Aktuell keine Events geplant — stay tuned.
    </div>
  )}

  <ol class="index">
    {events.map((ev, i) => (
      <li>
        <div data-animate="rise" data-scroll style={`--delay:${i * 0.04}s;--y:30px`} class="rowWrap">
          <div class="row" id={ev.id} data-status={ev.status}>
            <span class="rowNo">{String(i + 1).padStart(2, '0')}</span>

            {ev.driveFileId && (
              <span class="rowThumb">
                <Photo
                  src={`/api/image/${ev.driveFileId}`}
                  alt={`${ev.title} — ${ev.place}`}
                  class="rowThumbImg"
                  position="center"
                  shade="bottom"
                  grain={false}
                  seed={20 + i}
                />
              </span>
            )}

            <span class="rowMain">
              <span class="rowTitle">
                {ev.title}
                <span class="rowUnderline" aria-hidden="true"></span>
              </span>
              <span class="rowDetails">
                <span class="rowDetailsInner">
                  <span class="rowMeta">
                    {[ev.venue, ev.place, ev.genre].filter(Boolean).join(' · ')}
                  </span>
                  {ev.text && <span class="rowText">{ev.text}</span>}
                  {ev.tickets && (
                    <a class="rowTickets" href={ev.tickets} target="_blank" rel="noopener noreferrer">
                      Tickets →
                    </a>
                  )}
                </span>
              </span>
            </span>

            <span class="rowDate">
              <span class="rowDateNum">{ev.dateLabel}</span>
              <span class="rowStatus">
                {ev.status === 'upcoming' ? 'kommend' : 'gewesen'}
              </span>
            </span>
          </div>
        </div>
      </li>
    ))}
  </ol>
</section>
