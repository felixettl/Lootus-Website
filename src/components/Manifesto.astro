---
import { manifesto, brand } from '../data/lootus.js'
---

<section class="manifesto" id="kollektiv" aria-label="Manifest">
  <div data-animate="rise" data-scroll class="manifestoTag">
    <span class="hair"></span> Manifest
  </div>

  <blockquote class="manifestoQuote" data-animate="lines" data-scroll>
    {manifesto.map((line, i) => (
      <p class="manifestoLine">
        <span class="lineMask"><span style={`--delay:${i * 0.08}s`}>{line}</span></span>
      </p>
    ))}
  </blockquote>

  <div data-animate="rise" data-scroll style="--delay:0.25s" class="manifestoAttr">
    {brand.legal} — {brand.region}
  </div>
</section>
