---
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="topbar">
  <div class="nav">
    <a href="/" class="wordmark" aria-label="Lootus Kollektiv">
      <img src="/img/Logo_TransBG.svg" alt="" class="mark" width="24" height="24" />
      <span>Lootus</span>
    </a>
    <nav class="desktopNav desktopNavLeft" aria-label="Hauptnavigation">
      <a href="/about" class="desktopNavItem">Über uns</a>
      <a href="/kontakt" class="desktopNavItem">Kontakt</a>
    </nav>
    <a href="/" class="logoOnly" aria-label="Lootus Kollektiv">
      <img src="/img/Logo_TransBG.svg" alt="" width="28" height="28" />
    </a>
    <nav class="desktopNav desktopNavRight" aria-label="Rechtliches">
      <a href="/impressum" class="desktopNavItem">Impressum</a>
      <a href="/datenschutz" class="desktopNavItem">Datenschutz</a>
    </nav>
    <button class="burger" id="burgerBtn" aria-label="Menü öffnen" aria-expanded="false" aria-controls="navMenu">
      <span class="burgerLine"></span>
      <span class="burgerLine"></span>
      <span class="burgerLine"></span>
    </button>
  </div>
</header>

<div class="navMenu" id="navMenu" aria-hidden="true">
  <div class="navPanel">
  <nav aria-label="Hauptnavigation" class="navMenuMain">
    <a href="/" class="navMenuItem" style="--i:0" aria-current={path === '/' ? 'page' : undefined}><span class="navMenuNum">01</span>Home</a>
    <a href="/about" class="navMenuItem" style="--i:1" aria-current={path === '/about' ? 'page' : undefined}><span class="navMenuNum">02</span>Über uns</a>
    <a href="/kontakt" class="navMenuItem" style="--i:2" aria-current={path === '/kontakt' ? 'page' : undefined}><span class="navMenuNum">03</span>Kontakt</a>
  </nav>
  <nav aria-label="Rechtliches" class="navMenuLegal">
    <a href="/impressum" class="navMenuItem navMenuSmall" style="--i:3">Impressum</a>
    <a href="/datenschutz" class="navMenuItem navMenuSmall" style="--i:4">Datenschutz</a>
  </nav>
  </div>
</div>

<script>
  const btn = document.getElementById('burgerBtn')!
  const menu = document.getElementById('navMenu')!

  function openMenu() {
    menu.classList.add('navMenuOpen')
    btn.classList.add('burgerOpen')
    btn.setAttribute('aria-expanded', 'true')
    menu.setAttribute('aria-hidden', 'false')
    document.body.style.overflow = 'hidden'
  }

  function closeMenu() {
    menu.classList.remove('navMenuOpen')
    btn.classList.remove('burgerOpen')
    btn.setAttribute('aria-expanded', 'false')
    menu.setAttribute('aria-hidden', 'true')
    document.body.style.overflow = ''
  }

  btn.addEventListener('click', () =>
    menu.classList.contains('navMenuOpen') ? closeMenu() : openMenu()
  )

  menu.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu()
  })

  menu.querySelectorAll('.navMenuItem').forEach((link) =>
    link.addEventListener('click', closeMenu)
  )

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu()
  })
</script>
