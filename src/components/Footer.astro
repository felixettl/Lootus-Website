---
import { brand } from '../data/lootus.js'
---

<footer class="footer" id="kontakt">
  <div class="footRule"></div>
  <div class="footGrid">
    <div class="footBrand">
      <span class="footMark">
        <img src="/img/Logo_TransBG.svg" alt="Lootus Kollektiv" class="footMarkIcon" width="34" height="34" />
        <span>Lootus</span>
      </span>
      <span class="footLegal">{brand.legal}</span>
    </div>

    <a
      href="https://www.instagram.com/lootus.kollektiv/"
      target="_blank"
      rel="noopener noreferrer"
      class="footInsta"
      aria-label="Lootus Kollektiv auf Instagram"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
      </svg>
      @lootus.kollektiv
    </a>
  </div>
  <div class="footBase">
    <span>© {brand.founded}–{new Date().getFullYear()} {brand.short}</span>
    <span>Lootus Kollektiv — Konstanz</span>
  </div>
</footer>
