        <path class="logoPetal" d="M334.12,278.13c9.73,42.97,28.74,83.72,56.5,121.16l.04.06c2.46,2.64,4.72,5.24,6.83,7.76,1.78,2.06,3.46,4.1,5.06,6.09,1.46-1.75,3-3.56,4.61-5.39,1.33-1.53,2.74-3.08,4.19-4.67l1.23-1.35c20.9-27.14,48.88-72,62.11-130,1.46-6.52,2.65-12.71,3.63-18.89,2.43-14.51,3.79-29.68,4.04-45.13,1.53-98.83-49.7-170.98-80-207.77-31.5,37.34-74.16,110.12-75.64,207.19h0c-.29,17,.93,34.33,3.63,51.51.99,6.43,2.26,12.96,3.77,19.43Z"/>
        <path class="logoPetal" d="M429.44,411.88c-1.33,1.73-2.68,3.45-4.03,5.14,51.83-8.81,139.03-32.78,216.47-97.76,7.32-6.13,14.59-12.69,21.61-19.51,3.17-3.06,6.18-6.11,9.07-9.16,60.43-62.81,82.01-128.13,89.69-164.89-52.95,7.69-146.88,30.65-228.49,99.08-12.69,10.66-24.65,22.05-35.54,33.85-7.04,40.74-21.98,80.31-44.41,117.61-7.48,12.41-15.68,24.4-24.38,35.64Z"/>
