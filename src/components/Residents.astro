        <path class="logoPetal" d="M375.27,448.72c1.33-1.73,2.68-3.45,4.03-5.14-51.83,8.81-139.03,32.78-216.47,97.76-7.32,6.13-14.59,12.69-21.61,19.51-3.17,3.06-6.18,6.11-9.07,9.16-60.43,62.81-82.01,128.13-89.69,164.89,52.95-7.69,146.88-30.65,228.49-99.08,12.69-10.66,24.65-22.05,35.54-33.85,7.04-40.74,21.98-80.31,44.41-117.61,7.48-12.41,15.68-24.4,24.38-35.64Z"/>
        <path class="logoPetal" d="M352.9,429.66c-1.42-.14-2.81-.36-4.2-.67-59.05-13.08-135.14-40.6-203.3-98.33-13.51-11.43-26.28-23.77-37.98-36.7-43.85-1.65-81.54,3.56-107.41,8.84,24.94,30.97,77.48,81.89,169.1,110.5h0c30.59,9.54,60.1,14.91,87.6,17.46-27.44,2.56-56.88,7.92-87.39,17.43h0C77.69,476.8,25.16,527.72.22,558.69c25.87,5.28,63.56,10.49,107.41,8.84,11.7-12.93,24.47-25.27,37.98-36.7,68.69-58.18,145.44-85.68,204.68-98.63.47-.1.93-.19,1.4-.26l9.43-1.46-8.22-.82Z"/>
      </svg>
      <h1 class="mastheadBrandText">
        <span>Lootus</span>
        <span class="mastheadBrandAccent">Kollektiv</span>
      </h1>
    </div>
    <div class="mastheadIntro">
      <p class="introText" data-animate="rise" data-scroll>
        <span class="introHi">Hi.</span>
        Schön, dass du da bist. Wir sind Lootus aus Konstanz und haben Lust, mit dir zusammen zu
        elektronischer Musik zu feiern: in einer Runde, in der du dich wohlfühlen kannst, auch wenn du
        noch niemanden kennst. Dafür stecken wir gemeinsam Zeit, Ideen und viel Herz in unsere Abende.
        Ob du einfach tanzen möchtest oder selbst eine Idee mitbringst: Wir freuen uns auf dich.
      </p>
    </div>
  </div>

  <div class="djTrack" role="list">
    {djs.map((dj, i) => (
      <article class="djCard" role="listitem" data-animate="rise" data-scroll style={`--delay:${i * 0.07}s;--y:20px`}>
        <div class="djCardImg">
          {dj.photoFileId && (
            <img
              src={`/api/image/${dj.photoFileId}`}
              alt={dj.artistName}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          )}
        </div>

        {dj.galleryFolderId && (
          <button
            class="djCardGallery"
            data-folder-id={dj.galleryFolderId}
            aria-label={`Galerie von ${dj.artistName} öffnen`}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </button>
        )}

        <div class="djCardSocials">
          {dj.instaUrl && (
            <a href={dj.instaUrl} target="_blank" rel="noopener noreferrer" class="djCardSocial" aria-label={`${dj.artistName} auf Instagram`}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          )}
          {dj.soundcloudUrl && (
            <a href={dj.soundcloudUrl} target="_blank" rel="noopener noreferrer" class="djCardSocial" aria-label={`${dj.artistName} auf SoundCloud`}>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M11.56 8.87V17h8.76c1.46 0 2.68-1.16 2.68-2.62a2.67 2.67 0 0 0-2.52-2.61C20.42 9.3 18.43 7.33 16 7.33c-1.29 0-2.46.5-3.43 1.54zM0 15.26c0 .96.77 1.74 1.73 1.74.96 0 1.73-.78 1.73-1.74V12.3a1.73 1.73 0 0 0-3.46 0v2.96zm4.68 1.45c0 .53.43.96.95.96.53 0 .96-.43.96-.96V10.5a.96.96 0 0 0-1.91 0v6.21zm2.64.36c0 .53.43.96.96.96s.96-.43.96-.96V9.22a.96.96 0 0 0-1.92 0v7.85zm2.65.17c0 .53.43.96.96.96s.96-.43.96-.96V8.87a.96.96 0 0 0-1.92 0v8.37z"/>
              </svg>
            </a>
          )}
        </div>

        <div class="djCardInfo">
          <span class="djCardArtist">{dj.artistName}</span>
          <span class="djCardRealName">{dj.firstName} {dj.lastName}</span>
          {dj.genre && <span class="djCardGenre">{dj.genre}</span>}
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Shared lightbox for all DJ galleries -->
<div class="djLightbox" id="djLightbox" hidden aria-modal="true" role="dialog" aria-label="Galerie">
  <button class="djLightboxClose" id="djLightboxClose" aria-label="Schließen">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <button class="djLightboxArrow djLightboxPrev" id="djLightboxPrev" aria-label="Vorheriges Bild">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <div class="djLightboxStage">
    <img class="djLightboxImg" id="djLightboxImg" src="" alt="" draggable="false" />
  </div>
  <button class="djLightboxArrow djLightboxNext" id="djLightboxNext" aria-label="Nächstes Bild">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
  <div class="djLightboxCounter" id="djLightboxCounter"></div>
</div>

<script>
  const lb = document.getElementById('djLightbox')!
  const lbImg = document.getElementById('djLightboxImg') as HTMLImageElement
  const lbCounter = document.getElementById('djLightboxCounter')!

  let fileIds: string[] = []
  let current = 0
  const cache = new Map<string, string[]>()

  function showImage(idx: number) {
    current = ((idx % fileIds.length) + fileIds.length) % fileIds.length
    lbImg.src = `/api/image/${fileIds[current]}`
    lbCounter.textContent = `${current + 1} / ${fileIds.length}`
    // hide arrows when only one image
    const arrows = lb.querySelectorAll<HTMLElement>('.djLightboxArrow')
    arrows.forEach(a => { a.style.display = fileIds.length <= 1 ? 'none' : '' })
  }

  function openLightbox(ids: string[]) {
    fileIds = ids
    lb.removeAttribute('hidden')
    document.body.style.overflow = 'hidden'
    showImage(0)
  }

  function closeLightbox() {
    lb.setAttribute('hidden', '')
    document.body.style.overflow = ''
    lbImg.src = ''
  }

  document.querySelectorAll<HTMLButtonElement>('.djCardGallery').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const folderId = btn.dataset.folderId
      if (!folderId) return

      if (cache.has(folderId)) {
        openLightbox(cache.get(folderId)!)
        return
      }

      lb.removeAttribute('hidden')
      document.body.style.overflow = 'hidden'
      lbImg.src = ''
      lbCounter.textContent = 'Lädt …'

      const res = await fetch(`/api/gallery/${folderId}`)
      const ids: string[] = await res.json()
      cache.set(folderId, ids)

      if (ids.length === 0) { closeLightbox(); return }
      openLightbox(ids)
    })
  })

  document.getElementById('djLightboxClose')!.addEventListener('click', closeLightbox)
  document.getElementById('djLightboxPrev')!.addEventListener('click', () => showImage(current - 1))
  document.getElementById('djLightboxNext')!.addEventListener('click', () => showImage(current + 1))

  lb.addEventListener('click', (e) => {
    const t = e.target as HTMLElement
    if (t === lb || t.classList.contains('djLightboxStage')) closeLightbox()
  })

  document.addEventListener('keydown', (e) => {
    if (lb.hasAttribute('hidden')) return
    if (e.key === 'Escape') closeLightbox()
    if (e.key === 'ArrowLeft') showImage(current - 1)
    if (e.key === 'ArrowRight') showImage(current + 1)
  })
</script>

<script>
  // Scroll-scrubbed petal assembly: flies in from the left as the logo enters at the
  // bottom of the screen, and scatters out to the right as it leaves near the top.
  const logo = document.querySelector<SVGSVGElement>('.mastheadLogo')

  if (logo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v))
    let ticking = false

    function update() {
      ticking = false
      const rect = logo!.getBoundingClientRect()
      const vh = window.innerHeight

      const enter = clamp01((vh * 0.99 - rect.top) / (vh * 0.18))
      const exit = clamp01((vh * 0.12 - rect.top) / (vh * 0.18))

      logo!.style.setProperty('--enter', String(enter))
      logo!.style.setProperty('--exit', String(exit))
    }

    function onScroll() {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(update)
      }
    }

    update()
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)
  }
</script>
