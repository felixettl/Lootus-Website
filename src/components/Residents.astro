---
import { residents } from '../data/lootus.js'
---

<section class="residents" id="kollektiv" aria-label="Residents">
  <div class="mastheadHead">
    <div class="mastheadIntro">
      <div data-animate="rise" data-scroll class="sectionKicker">Kollektiv</div>
      <div data-animate="rise" data-scroll style="--delay:0.06s" class="mastheadTitle">
        Unsere DJs
      </div>
    </div>

  </div>

  <ul class="masthead">
    {residents.map((r, i) => (
      <li>
        <div data-animate="rise" data-scroll style={`--delay:${i * 0.05}s;--y:20px`} class="contributor">
          <span class="contribName">{r.name}</span>
          <span class="contribRole">{r.role}</span>
          <span class="contribTag">{r.tag}</span>
        </div>
      </li>
    ))}
  </ul>
</section>
