---
import type { Slide } from '../data/slides'
interface Props {
  slides: Slide[]
}
const { slides } = Astro.props
---

<section class="slider" id="hero" aria-label="Galerie">
  {slides.map((slide, i) => (
    <div class:list={['slide', i === 0 && 'slideActive']} data-index={i}>
      <img
        class="slideImg"
        src={`/api/image/${slide.id}`}
        alt=""
        loading={i === 0 ? 'eager' : 'lazy'}
        draggable="false"
      />
      {slide.instagram && (
        <a class="slideInstagram" href={slide.instagram.url} target="_blank" rel="noopener noreferrer" aria-label={`Instagram: ${slide.instagram.displayName}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          <span>{slide.instagram.displayName}</span>
        </a>
      )}
    </div>
  ))}

  {slides.length === 0 && <div class="slideFallback" aria-hidden="true"></div>}

  <div class="sliderOverlay" aria-hidden="true"></div>

  <div class="sliderBrand">
    <img src="/img/Lootus-Schriftzug.png" alt="Lootus" class="sliderSchriftzug" />
  </div>

  {slides.length > 1 && (
    <>
      <button class="sliderArrow sliderArrowPrev" id="sliderPrev" aria-label="Vorheriges Bild">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="sliderArrow sliderArrowNext" id="sliderNext" aria-label="Nächstes Bild">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>

      <div class="sliderDots" aria-hidden="true">
        {slides.map((_, i) => (
          <button class:list={['sliderDot', i === 0 && 'sliderDotActive']} data-dot={String(i)}></button>
        ))}
      </div>
    </>
  )}
</section>

<script>
  const INTERVAL = 5000
  const section = document.getElementById('hero')
  if (section) {
    const slides = section.querySelectorAll<HTMLElement>('.slide')
    const dots = section.querySelectorAll<HTMLButtonElement>('.sliderDot')

    if (slides.length >= 2) {
      let current = 0
      let timer: ReturnType<typeof setInterval>

      function goTo(n: number) {
        slides[current].classList.remove('slideActive')
        dots[current]?.classList.remove('sliderDotActive')
        current = ((n % slides.length) + slides.length) % slides.length
        slides[current].classList.add('slideActive')
        dots[current]?.classList.add('sliderDotActive')
      }

      function start() {
        clearInterval(timer)
        timer = setInterval(() => goTo(current + 1), INTERVAL)
      }

      section.querySelector('#sliderPrev')?.addEventListener('click', () => { goTo(current - 1); start() })
      section.querySelector('#sliderNext')?.addEventListener('click', () => { goTo(current + 1); start() })
      dots.forEach(d => d.addEventListener('click', () => { goTo(Number(d.dataset.dot)); start() }))

      section.addEventListener('mouseenter', () => clearInterval(timer))
      section.addEventListener('mouseleave', start)

      start()
    }
  }
</script>
