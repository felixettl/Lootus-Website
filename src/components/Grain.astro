---
interface Props {
  class?: string
  opacity?: number
  seed?: number
}
const { class: className, opacity = 0.05, seed = 7 } = Astro.props
---

<svg class={className} aria-hidden="true" focusable="false" style={`opacity:${opacity}`}>
  <filter id={`grain-${seed}`}>
    <feTurbulence type="fractalNoise" baseFrequency="0.82" numOctaves="2" seed={seed} stitchTiles="stitch" />
    <feColorMatrix type="saturate" values="0" />
  </filter>
  <rect width="100%" height="100%" filter={`url(#grain-${seed})`} />
</svg>
