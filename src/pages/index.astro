---
import Base from '../layouts/Base.astro'
import Grain from '../components/Grain.astro'
import TopBar from '../components/TopBar.astro'
import HeroSlider from '../components/HeroSlider.astro'
import Programm from '../components/Programm.astro'
import Residents from '../components/Residents.astro'
import Footer from '../components/Footer.astro'
import { fetchEvents } from '../data/calendar'
import { fetchSlides } from '../data/slides'
import '../styles/global.css'
import '../styles/afterglow.css'

const [events, slides] = await Promise.all([fetchEvents(), fetchSlides()])
---

<Base>
  <div class="root">
    <Grain class="pageGrain" opacity={0.035} seed={2} />
    <div class="vignette" aria-hidden="true"></div>
    <TopBar />
    <div class="shell">
      <HeroSlider slides={slides} />
      <main>
        <Programm events={events} />
        <Residents />
      </main>
      <Footer />
    </div>
  </div>
</Base>
