---
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import '../styles/afterglow.css'
---

<Base title="Kontakt — Lootus Kollektiv" description="Kontaktiere Lootus Kollektiv per E-Mail.">
  <div class="root">
    <TopBar />
    <div class="shell">
      <main class="contact">
        <h1>Kontakt</h1>
        <p class="intro">
          Wir suchen immer nach Helfern für kommende Events und freuen uns über Menschen, die dem Verein beitreten
          möchten. Auch bei sonstigen Fragen sind wir gerne für dich da. Schreib uns dazu
          gerne eine E-Mail an
          <a href="mailto:lootuskollektiv@gmail.com">lootuskollektiv@gmail.com</a>
          oder schreib uns auf
          <a href="https://www.instagram.com/lootus.kollektiv/" target="_blank" rel="noopener noreferrer">Instagram</a>.
        </p>
      </main>
    </div>
    <Footer />
  </div>
</Base>

<style>
  .shell {
    max-width: var(--maxw, 1440px);
    margin: 0 auto;
    padding: clamp(6rem, 12vh, 9rem) var(--gutter, 1.5rem) 4rem;
  }
  .contact {
    max-width: 640px;
    margin: 0 auto;
  }
  .contact h1 {
    font-family: var(--narrow, inherit);
    letter-spacing: 0.02em;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1.5rem;
  }
  .intro {
    line-height: 1.6;
    color: var(--text, inherit);
    margin: 0;
  }
  .intro a {
    color: var(--amber, inherit);
    text-decoration: underline;
  }
</style>
