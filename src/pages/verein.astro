---
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import '../styles/global.css'
import '../styles/afterglow.css'
---

<Base
  title="Verein — Lootus Kollektiv"
  description="Werde Mitglied bei Lootus Kollektiv. Fülle das Beitrittsformular direkt aus."
>
  <div class="root">
    <TopBar />
    <div class="shell">
      <main class="verein">
        <h1>Mitglied werden</h1>
        <p class="intro">
          Du möchtest Teil von Lootus Kollektiv werden? Fülle einfach das Beitrittsformular unten aus.
          Deine Daten werden direkt und verschlüsselt an unsere Vereinsverwaltung
          <a href="https://easyverein.com" target="_blank" rel="noopener noreferrer">easyVerein</a>
          übertragen und laufen nicht über unsere eigenen Server.
        </p>
        <div class="embedWrap">
          <iframe
            src="https://easyverein.com/public/lootus/applicationform/29190?iframe=True"
            title="Lootus Kollektiv Beitrittsformular"
            loading="lazy"
          ></iframe>
        </div>
        <p class="fallback">
          Falls das Formular nicht lädt, kannst du es auch
          <a
            href="https://easyverein.com/public/lootus/applicationform/29190"
            target="_blank"
            rel="noopener noreferrer"
          >direkt bei easyVerein öffnen</a>.
        </p>
      </main>
    </div>
    <Footer />
  </div>
</Base>

<style>
  .shell {
    max-width: var(--maxw, 1440px);
    margin: 0 auto;
    padding: clamp(6rem, 12vh, 9rem) var(--gutter, 1.5rem) 4rem;
  }
  .verein {
    max-width: 720px;
    margin: 0 auto;
  }
  .verein h1 {
    font-family: var(--narrow, inherit);
    letter-spacing: 0.02em;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1.5rem;
  }
  .intro {
    line-height: 1.6;
    color: var(--text, inherit);
    margin: 0 0 2rem;
  }
  .intro a {
    color: var(--amber, inherit);
    text-decoration: underline;
  }
  .embedWrap {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
  }
  .embedWrap iframe {
    width: 100%;
    min-height: 800px;
    border: 0;
    display: block;
  }
  .fallback {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    color: var(--text, inherit);
    opacity: 0.8;
  }
  .fallback a {
    color: var(--amber, inherit);
    text-decoration: underline;
  }
</style>
