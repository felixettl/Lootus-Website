---
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import { fetchAbout, fetchGalleries } from '../data/about'
import { imageUrl } from '../lib/sanity'
import '../styles/global.css'
import '../styles/afterglow.css'

const [about, galleries] = await Promise.all([fetchAbout(), fetchGalleries()])

const formatDate = (iso: string) =>
  iso ? new Date(iso).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' }) : ''
---

<Base description={about.seoDescription || undefined}>
  <div class="root">
    <TopBar />
    <div class="shell">
      <main class="about">
        <h1>{about.title}</h1>
        {about.html && <div class="aboutText"><Fragment set:html={about.html} /></div>}

        {galleries.map((gallery) => (
          <section class="gallery">
            <h2>
              {gallery.name}
              {gallery.date && <time datetime={gallery.date}>{formatDate(gallery.date)}</time>}
            </h2>
            <div class="galleryMedia">
              <div class="galleryGrid">
                {gallery.images.map((ref) => (
                  <div class="galleryItem">
                    <img src={imageUrl(ref, 800)} alt={gallery.name} loading="lazy" />
                  </div>
                ))}
              </div>
              {gallery.images.length > 2 && (
                <button type="button" class="galleryToggle" aria-expanded="false">
                  Mehr anzeigen
                </button>
              )}
            </div>
          </section>
        ))}
      </main>
    </div>
    <Footer />
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.galleryToggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.closest('.gallery')!.classList.toggle('galleryOpen')
      btn.setAttribute('aria-expanded', String(open))
      btn.textContent = open ? 'Weniger anzeigen' : 'Mehr anzeigen'
    })
  })
</script>

<style>
  .shell {
    max-width: var(--maxw, 1440px);
    margin: 0 auto;
    padding: clamp(6rem, 12vh, 9rem) var(--gutter, 1.5rem) 4rem;
  }
  .about h1 {
    font-family: var(--narrow, inherit);
    letter-spacing: 0.02em;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 2rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .aboutText {
    max-width: 720px;
    margin: 0 auto 4rem;
  }
  .aboutText :global(h2) {
    font-size: 1.1rem;
    margin: 2rem 0 0.5rem;
    color: var(--amber);
  }
  .aboutText :global(p) {
    line-height: 1.7;
    color: var(--text-soft);
  }
  .aboutText :global(a) {
    text-decoration: underline;
  }
  .gallery {
    margin-bottom: 3.5rem;
  }
  .gallery h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    font-family: var(--narrow, inherit);
    font-size: clamp(1.4rem, 3vw, 2rem);
    margin: 0 0 1rem;
  }
  .gallery time {
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .galleryGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.5rem;
  }
  .galleryItem {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--ink-deep);
  }
  .galleryGrid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gallery:not(.galleryOpen) .galleryItem:nth-child(n + 3) {
    display: none;
  }
  .galleryMedia {
    position: relative;
  }
  .galleryToggle {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .galleryOpen .galleryToggle {
    position: static;
    display: block;
    margin-top: 0.75rem;
    background: none;
    border-color: var(--amber);
    color: var(--amber);
  }
</style>
