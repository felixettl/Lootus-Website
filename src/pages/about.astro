---
import Base from '../layouts/Base.astro'
import TopBar from '../components/TopBar.astro'
import Footer from '../components/Footer.astro'
import { fetchAbout } from '../data/about'
import { imageUrl } from '../lib/sanity'
import '../styles/global.css'
import '../styles/afterglow.css'

const about = await fetchAbout()
---

<Base description={about.seoDescription || undefined}>
  <div class="root">
    <TopBar />
    <div class="shell">
      <main class="about">
        <h1>{about.title}</h1>
        {about.sections.length > 0 ? (
          <div class="aboutSections">
            {about.sections.map((section) => (
              <section
                class:list={['aboutSection', section.backgroundImage && 'hasBackground']}
                style={section.backgroundImage ? `--section-image: url('${imageUrl(section.backgroundImage, 1800)}')` : undefined}
              >
                <div class="aboutSectionInner">
                  <div class="aboutSectionCopy">
                    <h2>{section.heading}</h2>
                    {section.html && <div class="aboutSectionText"><Fragment set:html={section.html} /></div>}
                  </div>
                  {section.galleryImages.length > 0 && (
                    <div class="sectionGallery" data-marquee>
                      <div class="sectionGalleryTrack">
                        <div class="sectionGalleryGroup">
                          {section.galleryImages.map((image) => (
                            <img src={imageUrl(image.asset, 1000)} alt={image.alt || section.heading} loading="lazy" />
                          ))}
                        </div>
                        <div class="sectionGalleryGroup" aria-hidden="true">
                          {section.galleryImages.map((image) => (
                            <img src={imageUrl(image.asset, 1000)} alt="" loading="lazy" />
                          ))}
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </section>
            ))}
          </div>
        ) : about.html ? (
          <div class="aboutText"><Fragment set:html={about.html} /></div>
        ) : null}

      </main>
    </div>
    <Footer />
  </div>
</Base>

<script>
  const backgroundSections = [...document.querySelectorAll<HTMLElement>('.aboutSection.hasBackground')]
  let frame = 0

  const updateBackgrounds = () => {
    frame = 0
    const viewportCenter = window.innerHeight / 2
    const fadeDistance = window.innerHeight * 0.75

    backgroundSections.forEach((section) => {
      const bounds = section.getBoundingClientRect()
      const sectionCenter = bounds.top + bounds.height / 2
      const opacity = Math.max(0, 0.5 * (1 - Math.abs(sectionCenter - viewportCenter) / fadeDistance))
      section.style.setProperty('--image-opacity', String(opacity))
    })
  }

  const requestBackgroundUpdate = () => {
    if (!frame) frame = requestAnimationFrame(updateBackgrounds)
  }

  window.addEventListener('scroll', requestBackgroundUpdate, { passive: true })
  window.addEventListener('resize', requestBackgroundUpdate)
  updateBackgrounds()

  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((gallery) => {
    const groups = [...gallery.querySelectorAll<HTMLElement>('.sectionGalleryGroup')]
    const updateOverflow = () => {
      gallery.classList.toggle('is-overflowing', groups[0].scrollWidth > gallery.clientWidth + 1)
    }
    new ResizeObserver(updateOverflow).observe(gallery)
    groups.forEach((group) => new ResizeObserver(updateOverflow).observe(group))
    updateOverflow()
  })

</script>

<style>
  .shell {
    max-width: var(--maxw, 1440px);
    margin: 0 auto;
    padding: clamp(6rem, 12vh, 9rem) var(--gutter, 1.5rem) 4rem;
  }
  .about h1 {
    font-family: var(--narrow, inherit);
    letter-spacing: 0.02em;
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 2rem;
    max-width: 720px;
    margin-inline: auto;
  }
  .aboutText {
    max-width: 720px;
    margin: 0 auto 4rem;
  }
  .aboutText :global(h2) {
    font-size: 1.1rem;
    margin: 2rem 0 0.5rem;
    color: var(--amber);
  }
  .aboutText :global(p) {
    line-height: 1.7;
    color: var(--text-soft);
  }
  .aboutText :global(a) {
    text-decoration: underline;
  }
  .aboutSection {
    position: relative;
    isolation: isolate;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: 4rem max(var(--gutter, 1.5rem), calc((100vw - 1100px) / 2));
    overflow: hidden;
  }
  .aboutSection + .aboutSection {
    margin-top: 1rem;
  }
  .aboutSection.hasBackground::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    content: '';
    opacity: var(--image-opacity, 0);
    background-image: linear-gradient(rgba(16, 16, 16, 0.28), rgba(16, 16, 16, 0.48)), var(--section-image);
    background-size: cover;
    background-position: center;
    will-change: opacity;
  }
  .aboutSectionInner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .aboutSectionCopy {
    max-width: 720px;
    margin: 0 auto;
  }
  .aboutSectionCopy h2 {
    margin: 0 0 1rem;
    color: var(--amber);
    font-family: var(--narrow, inherit);
    font-size: clamp(1.5rem, 3vw, 2rem);
  }
  .aboutSectionText :global(p) {
    margin: 0 0 1rem;
    color: var(--text-soft);
    line-height: 1.7;
  }
  .aboutSectionText :global(p:last-child) {
    margin-bottom: 0;
  }
  .aboutSectionText :global(a) {
    text-decoration: underline;
  }
  .sectionGallery {
    overflow: hidden;
    margin-top: 2rem;
  }
  .sectionGalleryTrack,
  .sectionGalleryGroup {
    display: flex;
    width: max-content;
  }
  .sectionGalleryTrack {
    gap: 0;
  }
  .sectionGalleryGroup {
    gap: 0.75rem;
    padding-right: 0.75rem;
  }
  .sectionGalleryGroup img {
    width: clamp(12rem, 25vw, 22rem);
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .sectionGalleryGroup[aria-hidden='true'] {
    display: none;
  }
  .sectionGallery.is-overflowing .sectionGalleryGroup[aria-hidden='true'] {
    display: flex;
  }
  .sectionGallery.is-overflowing .sectionGalleryTrack {
    animation: galleryDriftRight 48s linear infinite;
  }
  @keyframes galleryDriftRight {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sectionGallery {
      overflow-x: auto;
    }
    .sectionGallery.is-overflowing .sectionGalleryTrack {
      animation: none;
      transform: none;
    }
    .sectionGallery.is-overflowing .sectionGalleryGroup[aria-hidden='true'] {
      display: none;
    }
  }
</style>
