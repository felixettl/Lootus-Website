---
import { brand } from '../data/lootus.js'

interface Props {
  description?: string
  noindex?: boolean
}
const title = 'Lootus Kollektiv'
const {
  description = 'Wir sind das Lootus Kollektiv, ein Technoverein aus Konstanz am Bodensee. Wir veranstalten Partys mit Progressive, Peaktime und Acid Techno.',
  noindex = false,
} = Astro.props

const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const canonicalURL = new URL(canonicalPath, Astro.site)
const ogImageURL = new URL('/img/Logo_BlackBG.png', Astro.site)
const googleVerification = process.env.GOOGLE_SITE_VERIFICATION

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: brand.name,
  alternateName: brand.short,
  url: 'https://lootuskollektiv.de',
  description,
  logo: new URL('/img/Logo_TransBG.svg', Astro.site).toString(),
  foundingDate: String(brand.founded),
  genre: brand.sound,
  address: {
    '@type': 'PostalAddress',
    addressLocality: brand.city,
    addressCountry: 'DE',
  },
  sameAs: ['https://www.instagram.com/lootus.kollektiv/'],
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <link rel="preload" href="/fonts/bebas-neue-v16-latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/img/Logo_TransBG.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/Logo_BlackBG.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/img/Logo_BlackBG.png" />
    <meta name="theme-color" content="#101010" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="de_DE" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <slot />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      // Mount animations fire immediately
      document.querySelectorAll<HTMLElement>('[data-mount]').forEach(el => {
        if (reduce) { el.classList.add('visible'); return }
        requestAnimationFrame(() => el.classList.add('visible'))
      })

      // Scroll-triggered animations
      if (!reduce) {
        const obs = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible')
              obs.unobserve(entry.target)
            }
          })
        }, { rootMargin: '-10% 0px' })
        document.querySelectorAll('[data-scroll]').forEach(el => obs.observe(el))
      } else {
        document.querySelectorAll('[data-scroll]').forEach(el => el.classList.add('visible'))
      }


    </script>
  </body>
</html>
